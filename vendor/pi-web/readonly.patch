 	}
 }
+
+func TestCairnEventsHeartbeatAndDisconnect(t *testing.T) {
+	s := &Server{clients: make([]*sseClient, 0), lastKnown: make(map[string]struct{})}
+	request := httptest.NewRequest(http.MethodGet, "/events?id=fixture.jsonl", nil)
+	ctx, cancel := context.WithCancel(request.Context())
+	defer cancel()
+	recorder := newSyncRecorder()
+	done := make(chan struct{})
+	go func() { s.handleEventsWithHeartbeat(recorder, request.WithContext(ctx), time.Millisecond); close(done) }()
+	waitFor(t, recorder, ": heartbeat")
+	if strings.Contains(recorder.body(), "data:") {
+		t.Fatal("keepalive must not invent activity")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("disconnected subscriber was retained")
+	}
+	s.clientsMu.RLock()
+	defer s.clientsMu.RUnlock()
+	if len(s.clients) != 0 {
+		t.Fatal("disconnected subscriber was not removed")
+	}
+}
