diff --git a/internal/app/cairn_readonly.go b/internal/app/cairn_readonly.go
new file mode 100644
index 0000000..aca8178
--- /dev/null
+++ b/internal/app/cairn_readonly.go
@@ -0,0 +1,28 @@
+package app
+
+import (
+	"net/http"
+	"strings"
+)
+
+// Cairn publishes only the pinned upstream viewer. Even loopback callers cannot
+// create/resume workers, read arbitrary host files, share externally, or mutate data.
+func cairnReadOnly(next http.Handler) http.Handler {
+	allowed := map[string]bool{
+		"/": true, "/session": true, "/events": true,
+		"/api/session": true, "/api/sessions": true, "/api/settings": true,
+		"/api/worker-status": true, "/api/annotations": true,
+		"/api/chat/queue": true, "/api/projects": true, "/api/scratchpad": true,
+		"/custom-themes.css": true,
+	}
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if (r.Method != http.MethodGet && r.Method != http.MethodHead) ||
+			(!allowed[r.URL.Path] && !strings.HasPrefix(r.URL.Path, "/static/assets/")) {
+			http.Error(w, "Cairn session viewer is read-only", http.StatusForbidden)
+			return
+		}
+		w.Header().Set("X-Cairn-Viewer", "read-only")
+		w.Header().Set("Content-Security-Policy", "frame-ancestors 'self'")
+		next.ServeHTTP(w, r)
+	})
+}
diff --git a/internal/app/cairn_readonly_test.go b/internal/app/cairn_readonly_test.go
new file mode 100644
index 0000000..68b200e
--- /dev/null
+++ b/internal/app/cairn_readonly_test.go
@@ -0,0 +1,31 @@
+package app
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestCairnReadOnly(t *testing.T) {
+	gate := cairnReadOnly(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
+	for _, tc := range []struct {
+		method, path string
+		code         int
+	}{
+		{"GET", "/session?id=managed.jsonl", 204},
+		{"GET", "/events?id=managed.jsonl", 204},
+		{"GET", "/static/assets/app.js", 204},
+		{"GET", "/api/session?id=managed.jsonl", 204},
+		{"POST", "/api/chat", 403}, {"GET", "/api/commands", 403},
+		{"GET", "/api/files?path=/etc/passwd", 403},
+		{"GET", "/share?id=managed.jsonl", 403},
+		{"POST", "/api/settings", 403}, {"POST", "/api/new-session", 403},
+		{"GET", "/api/models", 403}, {"GET", "/api/update", 403},
+	} {
+		response := httptest.NewRecorder()
+		gate.ServeHTTP(response, httptest.NewRequest(tc.method, tc.path, nil))
+		if response.Code != tc.code {
+			t.Errorf("%s %s = %d, want %d", tc.method, tc.path, response.Code, tc.code)
+		}
+	}
+}
